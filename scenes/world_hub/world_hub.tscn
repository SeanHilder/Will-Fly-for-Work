script = ExtResource("4_dlog")
dialog_box = NodePath("../../ui/dialog_box")
dialog_lines = Array[String](["JOBB-E|Welcome to WorkedIn curbside support! Scanning employment history... complete. Oh. Oh dear.", "YOU|Rude.", "JOBB-E|Listed skills: 'hands', 'improvisation', 'showing up anyway'. None of these compile.", "YOU|I already GOT a job. Biological chaos technician. On Ataraxia.", "JOBB-E|Correct! Minor detail: Ataraxia is 4,242 light-years away. Relocation assistance was optimized out in Q3.", "YOU|...So how do I get there?", "JOBB-E|Standard commute: fly to the next planet, do whatever job is too messy for robots, get paid in the parts your ship is missing, repeat until Ataraxia.", "YOU|That's not a commute, that's a career.", "JOBB-E|Glad we agree. The spaceport is northeast. Chop chop -- your joints are organic and the warranty is void."])
speaker_colors = {
"JOBB-E": Color(0.49, 0.91, 1, 1),
"YOU": Color(0.95, 0.7, 0.24, 1)
}

